{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Minimal semantic deck specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "deck",
    "narrative",
    "slides"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "deck": {
      "$ref": "#/$defs/deck"
    },
    "narrative": {
      "$ref": "#/$defs/narrative"
    },
    "slides": {
      "$ref": "#/$defs/slides"
    },
    "extensions": {
      "type": "object",
      "default": {},
      "additionalProperties": true
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "stableIdArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stableId"
      }
    },
    "nonEmptyStableIdArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stableId"
      }
    },
    "deck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "audience",
        "objective",
        "language"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 2
        },
        "targets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "narrative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "thesis"
      ],
      "properties": {
        "profile": {
          "$ref": "#/$defs/stableId"
        },
        "thesis": {
          "type": "string",
          "minLength": 1
        },
        "required_roles": {
          "$ref": "#/$defs/nonEmptyStableIdArray"
        }
      }
    },
    "slides": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "items"
      ],
      "properties": {
        "order": {
          "$ref": "#/$defs/nonEmptyStableIdArray"
        },
        "items": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/stableId"
          },
          "additionalProperties": {
            "$ref": "#/$defs/slide"
          }
        }
      }
    },
    "slide": {
      "type": "object",
      "required": [
        "title",
        "purpose",
        "takeaway",
        "narrative_roles"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "takeaway": {
          "type": "string",
          "minLength": 1
        },
        "narrative_roles": {
          "$ref": "#/$defs/nonEmptyStableIdArray"
        },
        "dependencies": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/dependency"
          }
        }
      },
      "additionalProperties": true
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/stableId"
        },
        "relation": {
          "type": "string",
          "minLength": 1
        },
        "propagates": {
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
